# Copy this file outside the repository as production.env.local and pass it to
# scripts/start-production-windows.ps1 with -EnvFile. Never commit the local copy.
NODE_ENV=production
HOST=127.0.0.1
PORT=4327

# Codex Device Gateway and WebRTC. Keep the TURN shared secret outside Git and
# use the same value as coturn static-auth-secret.
XHS_CODEX_MIRROR_ICE_SERVERS_JSON=[{"urls":"stun:turn.example.com:3478"}]
XHS_CODEX_TURN_URLS_JSON=["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"]
XHS_CODEX_TURN_SHARED_SECRET=
XHS_CODEX_TURN_CREDENTIAL_TTL_SECONDS=600
XHS_CODEX_DEVICE_GATEWAY_STATE_PATH=./data/codex-relay/devices.json
XHS_CODEX_DEVICE_GATEWAY_AUDIT_PATH=./data/codex-relay/audit.jsonl
XHS_CODEX_DEVICE_GATEWAY_HEARTBEAT_SECONDS=15
XHS_CODEX_CONNECT_ALLOWED_ORIGINS=https://relay.hegelsalon.com
XHS_CODEX_CONNECTOR_VERSION=1.2.18
XHS_CODEX_CONNECTOR_INSTALLER_PATH=./output/codex-local-connector-1.2.18.zip
XHS_CODEX_RUNTIME_BASELINE_PATH=./output/codex-runtimes/known-good.json
XHS_CODEX_PROTOCOL_EVIDENCE_ROOT=./output/codex-web-runtime-probe
XHS_CODEX_WORKTREE_ROOT=./data/codex-worktrees

# Set to never only when this runtime is controlled by the application owner.
XHS_COPILOT_APPROVAL_MODE=required

# MCP remains a separate loopback-only listener. Cloudflare Tunnel terminates
# TLS for the dedicated public hostname and forwards only that hostname here.
XHS_MCP_ENABLED=true
XHS_MCP_HOST=127.0.0.1
XHS_MCP_PORT=4328
XHS_MCP_PUBLIC_URL=https://mcp.hegelsalon.com
XHS_MCP_REQUIRE_CLOUDFLARE_HEADERS=true
XHS_MCP_PUBLIC_SHOWCASE_ENABLED=true
XHS_MCP_PUBLIC_SHOWCASE_MAX_BODY_BYTES=65536
XHS_MCP_PUBLIC_SHOWCASE_MAX_CALLS_PER_MINUTE=60
XHS_MCP_PUBLIC_SHOWCASE_MAX_CONCURRENT_REQUESTS=4
XHS_MCP_MAX_BODY_BYTES=1048576
XHS_MCP_MAX_OUTPUT_BYTES=2097152
XHS_MCP_TOOL_TIMEOUT_MS=120000
XHS_MCP_MAX_CONCURRENT_TOOLS_PER_GRANT=4
XHS_MCP_MAX_CALLS_PER_MINUTE=120
XHS_MCP_SESSION_IDLE_SECONDS=1800
XHS_MCP_MAX_SESSIONS=20
XHS_MCP_MAX_SESSIONS_PER_GRANT=4

# Public host is served by the dedicated remote-managed hegelsalon-relay tunnel.
CLOUDFLARE_PUBLIC_URL=https://relay.hegelsalon.com
CLOUDFLARE_MCP_PUBLIC_URL=https://mcp.hegelsalon.com
CLOUDFLARE_TUNNEL_NAME=hegelsalon-relay
CLOUDFLARE_METRICS=127.0.0.1:20242
# Keep the token outside the repository, for example:
# CLOUDFLARE_TUNNEL_TOKEN_FILE=C:\Users\<user>\.cloudflared\hegelsalon-relay.token

# Public workbench mode opens the application and its API without a login page.
XHS_AUTH_REQUIRED=false
XHS_AUTH_SECURE_COOKIE=true
XHS_AUTH_ORIGIN=https://relay.hegelsalon.com
# Set XHS_AUTH_REQUIRED=true before provisioning an administrator account.

# The production launcher enables the persisted audience-analysis workflow by
# default. Set this explicitly to false only for maintenance.
XHS_AUDIENCE_AI_ENABLED=true

# The portable bundle defaults to its own data directory. For a protected
# external volume, uncomment these entries and replace the example root.
# XHS_SERVER_DATA_DIR=D:\xhs-data\jobs
# XHS_PROFILE_DATA_DIR=D:\xhs-data\profiles
# XHS_BROWSER_DATA_DIR=D:\xhs-data\browser
# XHS_RELAY_CONFIG_PATH=D:\xhs-data\relay-config.json
# XHS_AI_CONFIG_PATH=D:\xhs-data\ai-config.json
# XHS_SMTP_CONFIG_PATH=D:\xhs-data\smtp-config.json
# XHS_DATA_RETENTION_PATH=D:\xhs-data\data-retention.json
# XHS_DELETION_AUDIT_PATH=D:\xhs-data\deletion-audit.jsonl
# XHS_DIAGNOSTICS_PATH=D:\xhs-data\diagnostics.jsonl
# XHS_AUTH_USERS_PATH=D:\xhs-data\auth\users.json
# XHS_AUTH_SESSION_SECRET_PATH=D:\xhs-data\auth\session-secret
# XHS_MCP_TOKEN_PEPPER_PATH=D:\xhs-data\auth\mcp-token-pepper

XHS_MAX_BODY_BYTES=33554432
XHS_ATTACHMENT_MAX_FILES=5
XHS_ATTACHMENT_MAX_FILE_BYTES=10485760
XHS_ATTACHMENT_MAX_TOTAL_BYTES=20971520
