# Copy this file outside the repository as production.env.local and pass it to
# scripts/start-production-windows.ps1 with -EnvFile. Never commit the local copy.
NODE_ENV=production
HOST=127.0.0.1
PORT=4327

# Public host is served by the dedicated remote-managed hegelsalon-relay tunnel.
CLOUDFLARE_PUBLIC_URL=https://relay.hegelsalon.com
CLOUDFLARE_TUNNEL_NAME=hegelsalon-relay
CLOUDFLARE_METRICS=127.0.0.1:20242
# Keep the token outside the repository, for example:
# CLOUDFLARE_TUNNEL_TOKEN_FILE=C:\Users\<user>\.cloudflared\hegelsalon-relay.token

# Public deployments must use the application account layer.
XHS_AUTH_REQUIRED=true
XHS_AUTH_SECURE_COOKIE=true
XHS_AUTH_ORIGIN=https://relay.hegelsalon.com
# XHS_AUTH_EMAIL=admin@example.invalid
# Inject XHS_AUTH_PASSWORD only for auth provisioning; do not persist it here.

# The portable bundle defaults to its own data directory. For a protected
# external volume, uncomment these entries and replace the example root.
# XHS_SERVER_DATA_DIR=D:\xhs-data\jobs
# XHS_PROFILE_DATA_DIR=D:\xhs-data\profiles
# XHS_BROWSER_DATA_DIR=D:\xhs-data\browser
# XHS_RELAY_CONFIG_PATH=D:\xhs-data\relay-config.json
# XHS_AI_CONFIG_PATH=D:\xhs-data\ai-config.json
# XHS_SMTP_CONFIG_PATH=D:\xhs-data\smtp-config.json
# XHS_DATA_RETENTION_PATH=D:\xhs-data\data-retention.json
# XHS_DELETION_AUDIT_PATH=D:\xhs-data\deletion-audit.jsonl
# XHS_DIAGNOSTICS_PATH=D:\xhs-data\diagnostics.jsonl
# XHS_AUTH_USERS_PATH=D:\xhs-data\auth\users.json
# XHS_AUTH_SESSION_SECRET_PATH=D:\xhs-data\auth\session-secret

XHS_MAX_BODY_BYTES=33554432
XHS_ATTACHMENT_MAX_FILES=5
XHS_ATTACHMENT_MAX_FILE_BYTES=10485760
XHS_ATTACHMENT_MAX_TOTAL_BYTES=20971520
