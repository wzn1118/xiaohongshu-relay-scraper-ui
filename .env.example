# HTTP service
HOST=127.0.0.1
PORT=4317
# Leave blank to use python on Windows and python3 on Linux/macOS.
PYTHON_BIN=

# Optional Codex home. Blank uses the normal user profile directory (.codex).
CODEX_HOME=
XHS_CODEX_EXECUTABLE=

# Codex Local Relay v2. Static STUN entries are optional. TURN REST credentials
# are generated per session when both TURN URLs and a shared secret are set.
XHS_CODEX_MIRROR_ICE_SERVERS_JSON=[]
XHS_CODEX_TURN_URLS_JSON=[]
XHS_CODEX_TURN_SHARED_SECRET=
XHS_CODEX_TURN_CREDENTIAL_TTL_SECONDS=600
XHS_CODEX_DEVICE_GATEWAY_STATE_PATH=./data/codex-relay/devices.json
XHS_CODEX_DEVICE_GATEWAY_AUDIT_PATH=./data/codex-relay/audit.jsonl
XHS_CODEX_DEVICE_GATEWAY_HEARTBEAT_SECONDS=15
XHS_CODEX_CONNECT_ALLOWED_ORIGINS=
XHS_CODEX_CONNECTOR_VERSION=1.2.18
XHS_CODEX_CONNECTOR_INSTALLER_PATH=./output/codex-local-connector-1.2.18.zip
XHS_CODEX_RUNTIME_BASELINE_PATH=./output/codex-runtimes/known-good.json
XHS_CODEX_PROTOCOL_EVIDENCE_ROOT=./output/codex-web-runtime-probe
XHS_CODEX_WORKTREE_ROOT=./data/codex-worktrees

# Portable discovery normally uses CODEX_HOME. Set explicit paths only when the
# xiaohongshu-relay-scrape skill is stored elsewhere.
XHS_UPSTREAM_RUNNER=
XHS_UPSTREAM_SCRAPER=

# Runtime data stays outside Git.
XHS_SERVER_DATA_DIR=./data/jobs
XHS_PROFILE_DATA_DIR=./data/profiles

# Local MCP data plane. It is enabled by default and always binds to loopback.
# Create scoped Grant tokens from the MCP management panel after the app starts.
XHS_MCP_ENABLED=true
XHS_MCP_HOST=127.0.0.1
XHS_MCP_PORT=4328
XHS_MCP_PUBLIC_URL=
XHS_MCP_REQUIRE_CLOUDFLARE_HEADERS=false
XHS_MCP_PUBLIC_SHOWCASE_ENABLED=false
XHS_MCP_PUBLIC_SHOWCASE_MAX_BODY_BYTES=65536
XHS_MCP_PUBLIC_SHOWCASE_MAX_CALLS_PER_MINUTE=60
XHS_MCP_PUBLIC_SHOWCASE_MAX_CONCURRENT_REQUESTS=4
XHS_MCP_MAX_BODY_BYTES=1048576
XHS_MCP_MAX_OUTPUT_BYTES=2097152
XHS_MCP_TOOL_TIMEOUT_MS=120000
XHS_MCP_MAX_CONCURRENT_TOOLS_PER_GRANT=4
XHS_MCP_MAX_CALLS_PER_MINUTE=120
XHS_MCP_SESSION_IDLE_SECONDS=1800
XHS_MCP_MAX_SESSIONS=20
XHS_MCP_MAX_SESSIONS_PER_GRANT=4

# Data Copilot local runner and outbound MCP clients. Secrets are referenced by
# environment-variable name in the MCP configuration, never stored inline.
# Start from config/copilot-mcp-servers.example.json when provisioning servers.
XHS_COPILOT_MCP_CONFIG_PATH=./data/copilot-mcp-servers.json
XHS_COPILOT_WORKSPACE_ROOT=.
# Owner mode executes every selected tool immediately without a human approval pause.
XHS_COPILOT_APPROVAL_MODE=never
XHS_COPILOT_EXEC_TIMEOUT_MS=30000
XHS_COPILOT_HTTP_TIMEOUT_MS=30000
XHS_COPILOT_MAX_OUTPUT_BYTES=262144

# Optional overrides
# The project-managed Chromium profile is isolated from the user's normal browser.
XHS_BROWSER_PATH=
XHS_BROWSER_DATA_DIR=./data/browser
OPENCLAW_CONFIG_PATH=
XHS_RELAY_CONFIG_PATH=
CODEX_CLI_BIN=
XHS_AI_TIMEOUT_SECONDS=600
# Local structured generation defaults to 4096. Lower this on slower local
# models when the requested schema comfortably fits a smaller response budget.
XHS_AI_MAX_OUTPUT_TOKENS=4096

# Optional local OCR inference pool. Each reachable endpoint receives a worker
# shard; unavailable endpoints are ignored for that run.
XHS_APPLICATION_CONTACT_OCR_BASE_URLS=http://127.0.0.1:11434/v1
XHS_APPLICATION_CONTACT_OCR_DEDICATED_ENABLED=false
XHS_APPLICATION_CONTACT_OCR_DEDICATED_ENDPOINT=http://127.0.0.1:11435
XHS_APPLICATION_CONTACT_OCR_MODEL=qwen3.5:4b
XHS_APPLICATION_CONTACT_OCR_MODEL_PARALLEL=2
XHS_APPLICATION_CONTACT_OCR_CONTEXT_TOKENS=4096
XHS_APPLICATION_CONTACT_OCR_MAX_OUTPUT_TOKENS=256
XHS_APPLICATION_CONTACT_OCR_KEEP_ALIVE=60m
XHS_APPLICATION_CONTACT_OCR_CONCURRENCY=2
XHS_APPLICATION_CONTACT_OCR_PREFETCH_CONCURRENCY=12
XHS_APPLICATION_CONTACT_OCR_IMAGE_BATCH_SIZE=4

# Per-post audience AI is isolated behind a release flag and defaults off.
XHS_AUDIENCE_AI_ENABLED=false
XHS_AUDIENCE_AI_RUNNER_PATH=./scripts/run_audience_ai.py
XHS_AUDIENCE_AI_MAX_CONCURRENT=2

# Optional SMTP delivery. Leave SMTP_HOST blank to keep email sending disabled.
# Microsoft 365 uses smtp.office365.com:587 with STARTTLS and OAuth2.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_AUTH=auto
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_OAUTH_TENANT=organizations
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_OAUTH_SCOPE=https://outlook.office.com/SMTP.Send offline_access openid profile email
# Application email attachment limits
XHS_ATTACHMENT_MAX_FILES=5
XHS_ATTACHMENT_MAX_FILE_BYTES=10485760
XHS_ATTACHMENT_MAX_TOTAL_BYTES=20971520
