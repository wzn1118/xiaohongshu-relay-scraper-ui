# HTTP service
HOST=127.0.0.1
PORT=4317
# Leave blank to use python on Windows and python3 on Linux/macOS.
PYTHON_BIN=

# Portable discovery normally uses CODEX_HOME. Set explicit paths only when the
# xiaohongshu-relay-scrape skill is stored elsewhere.
XHS_UPSTREAM_RUNNER=
XHS_UPSTREAM_SCRAPER=

# Runtime data stays outside Git.
XHS_SERVER_DATA_DIR=./data/jobs
XHS_PROFILE_DATA_DIR=./data/profiles

# Optional overrides
OPENCLAW_CONFIG_PATH=
XHS_RELAY_CONFIG_PATH=
CODEX_CLI_BIN=
XHS_AI_TIMEOUT_SECONDS=600

# Optional SMTP delivery. Leave blank to keep email sending disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
